<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_letter_reset_wizard" model="ir.ui.view">
        <field name="name">letter.reset.wizard.form</field>
        <field name="model">letter.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Reset">
                <group>
                    <p>
                        Are you sure you want to reset this letter to draft?<br/>
                        This will also reset the linked request.
                    </p>
                </group>
                <footer>
                    <button name="action_confirm_reset" type="object" string="Yes" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="No" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
